# Ollama server URL (change if running Ollama on a different host/port)
OLLAMA_HOST=http://localhost:11434

# Vision model used for image analysis (must be pulled via `ollama pull <model>`)
VISION_MODEL=moondream

# Text model used for caption generation (must be pulled via `ollama pull <model>`)
TEXT_MODEL=llama3.2:3b

# Set to 1 to use smaller token budgets / image sizes (recommended for laptops ≤16 GB RAM)
FAST_LOCAL=0

# Set to 1 to automatically pick the best available Ollama model on startup
AUTO_TUNE=0
